<div class="tab-pane fade {{#if (eq user.role 'superadmin')}}show active{{/if}}" id="users" role="tabpanel">
    <div class="glass-panel p-4 rounded-4 shadow-sm h-100 position-relative">
        <div class="mb-3">
            <form class="row g-2" role="search" onsubmit="event.preventDefault();">
                <div class="col-md-3">
                    <div class="input-group glass-panel h-100 shadow-sm">
                        <label for="userSearchInput" class="input-group-text bg-white border-end-0 cursor-pointer mb-0"><i class="bi bi-search text-primary" aria-hidden="true"></i><span class="visually-hidden">Search users</span></label>
                        <input aria-label="Search users" type="search" class="form-control border-start-0 ps-0" id="userSearchInput" placeholder="Search users..." autocomplete="off">
                    </div>
                </div>
                <div class="col-md-7 d-flex align-items-center">
                    <small class="text-muted ms-md-2" id="userResultCount" aria-live="polite"></small>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-primary h-100 w-100 fw-bold shadow-sm rounded-3" data-bs-toggle="modal" data-bs-target="#createUserModal">
                        <i class="bi bi-person-plus-fill me-1" aria-hidden="true"></i> Create User
                    </button>
                </div>
            </form>
        </div>

        <div class="rounded-4 shadow-sm border border-light table-responsive-wrapper bg-white">
            <table class="table table-hover align-middle mb-0 bg-white custom-table" id="usersTable">
                <thead class="table-light">
                    <tr>
                        <th class="px-4" scope="col">Name</th>
                        <th scope="col">Username</th>
                        <th scope="col">Role</th>
                        <th scope="col">Step 2 & Step 3 Access</th>
                        <th class="text-center pe-4 ps-3 text-nowrap" scope="col">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span> Loading users...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade glass-modal" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h2 class="modal-title fs-6 fw-bold text-primary" id="createUserModalLabel"><i class="bi bi-person-plus-fill me-2" aria-hidden="true"></i>Create User</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pb-3 pt-3">
                <form id="createUserForm">
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="createName">Full Name</label>
                        <input type="text" name="name" id="createName" class="form-control form-control-sm" maxlength="100" autocomplete="off" required>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="createUsername">Username</label>
                        <input type="text" name="username" id="createUsername" class="form-control form-control-sm" maxlength="100" autocomplete="off" autocapitalize="none" spellcheck="false" required>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="createPassword">Password</label>
                        <div class="input-group input-group-sm">
                            <input type="password" name="password" id="createPassword" class="form-control" minlength="8" autocomplete="new-password" aria-describedby="createPasswordHelp" required>
                            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="createPassword" aria-label="Show password" aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="form-text small text-muted" id="createPasswordHelp" style="font-size: 0.75rem;">At least 8 characters, with at least 1 letter and 1 number.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="createConfirmPassword">Confirm Password</label>
                        <div class="input-group input-group-sm">
                            <input type="password" name="confirmPassword" id="createConfirmPassword" class="form-control" minlength="8" autocomplete="new-password" required>
                            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="createConfirmPassword" aria-label="Show password" aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small text-muted mb-1" for="createRole">Role</label>
                        <select name="role" id="createRole" class="form-select form-select-sm custom-ui-select">
                            <option value="evaluator">Evaluator</option>
                            {{#if (eq user.role 'superadmin')}}
                            <option value="admin">Admin</option>
                            {{/if}}
                        </select>
                    </div>
                    <div class="form-check form-switch mb-0">
                        <input type="checkbox" class="form-check-input" id="accessStep2" name="can_access_step2">
                        <label class="form-check-label small text-muted" for="accessStep2">Step 2 & Step 3 Access</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0 flex-nowrap gap-2">
                <button type="button" class="btn btn-sm btn-light shadow-sm w-50 m-0" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="createUserForm" id="createUserBtn" class="btn btn-sm btn-primary shadow-sm w-50 m-0"><i class="bi bi-check-circle me-1" aria-hidden="true"></i> Create</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit User Modal -->
<div class="modal fade glass-modal" id="editUserModal" tabindex="-1" aria-labelledby="editUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h2 class="modal-title fs-6 fw-bold text-primary" id="editUserModalLabel"><i class="bi bi-person-gear me-2" aria-hidden="true"></i>Edit User</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pb-3 pt-3">
                <form id="editUserForm">
                    <input type="hidden" name="id" id="editUserId">
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="editUserRole">Role</label>
                        <select name="role" id="editUserRole" class="form-select form-select-sm custom-ui-select">
                            <option value="evaluator">Evaluator</option>
                            {{#if (eq user.role 'superadmin')}}
                            <option value="admin">Admin</option>
                            {{/if}}
                        </select>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input type="checkbox" class="form-check-input" id="editAccessStep2" name="can_access_step2">
                        <label class="form-check-label small text-muted" for="editAccessStep2">Step 2 & Step 3 Access</label>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="editPassword">Reset Password</label>
                        <div class="input-group input-group-sm">
                            <input type="password" name="password" id="editPassword" class="form-control" placeholder="Leave blank to keep" minlength="8" autocomplete="new-password" aria-describedby="editPasswordHelp">
                            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="editPassword" aria-label="Show password" aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                        <div class="form-text small text-muted" id="editPasswordHelp" style="font-size: 0.75rem;">At least 8 characters, with at least 1 letter and 1 number.</div>
                    </div>
                    <div class="mb-2">
                        <label class="form-label small text-muted mb-1" for="editConfirmPassword">Confirm Password</label>
                        <div class="input-group input-group-sm">
                            <input type="password" name="confirmPassword" id="editConfirmPassword" class="form-control" placeholder="Leave blank to keep" minlength="8" autocomplete="new-password">
                            <button class="btn btn-outline-secondary toggle-password" type="button" data-target="editConfirmPassword" aria-label="Show password" aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top-0 pt-0 flex-nowrap gap-2">
                <button type="button" class="btn btn-sm btn-light shadow-sm w-50 m-0" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="editUserForm" id="editUserBtn" class="btn btn-sm btn-primary shadow-sm w-50 m-0"><i class="bi bi-save me-1" aria-hidden="true"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete User Modal -->
<div class="modal fade glass-modal" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h2 class="modal-title fs-6 fw-bold text-danger" id="deleteUserModalLabel"><i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>Delete User</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pb-2 pt-3 text-center">
                <p class="mb-0 text-muted small">Are you sure you want to delete this user? This action cannot be undone.</p>
                <input type="hidden" id="deleteUserId">
            </div>
            <div class="modal-footer border-top-0 pt-0 mt-3 flex-nowrap gap-2">
                <button type="button" class="btn btn-sm btn-light shadow-sm w-50 m-0" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="deleteUserBtn" class="btn btn-sm btn-danger shadow-sm w-50 m-0" onclick="executeDeleteUser()"><i class="bi bi-trash-fill me-1" aria-hidden="true"></i> Delete</button>
            </div>
        </div>
    </div>
</div>
