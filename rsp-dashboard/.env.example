DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=rsp_db
PORT=3000
# 0.0.0.0 = office LAN can reach the dashboard (limit it with deploy/firewall-dashboard-lan.ps1)
# 127.0.0.1 = only this PC. Never publish the dashboard through the Cloudflare Tunnel.
HOST=0.0.0.0
SUPERADMIN_USERNAME=superadmin
# At least 12 characters; production refuses to start with a weak or default value
SUPERADMIN_PASSWORD=

# Nodemailer SMTP Configuration

# Account 1 (Primary)
SMTP_HOST_1=smtp.gmail.com
SMTP_PORT_1=587
SMTP_USER_1=your-primary-account@gmail.com
SMTP_PASS_1=your_app_password
SMTP_GMAILNAME_1=HR Department (Primary)

# Account 2 (Secondary)
SMTP_HOST_2=smtp.gmail.com
SMTP_PORT_2=587
SMTP_USER_2=your-secondary-account@gmail.com
SMTP_PASS_2=your_app_password
SMTP_GMAILNAME_2=HR Department (Secondary)
# Security
NODE_ENV=production
# Required in production: at least 32 random characters. Generate one with
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# true only when the dashboard is served over HTTPS; plain-HTTP LAN installs must keep false
COOKIE_SECURE=false
# Optional: seeds an "admin" user on first start (no user is created when left empty)
ADMIN_PASSWORD=
# Optional: Express "trust proxy" setting (default: loopback)
TRUST_PROXY=loopback
