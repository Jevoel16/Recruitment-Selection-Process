{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rsp-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "rsp-dashboard",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "rsp-portal",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "rsp-portal",
        "start"
      ],
      "port": 3001
    },
    {
      "name": "rsp-dashboard-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "rsp-dashboard",
        "start"
      ],
      "env": { "NODE_ENV": "development" },
      "port": 3000
    }
  ]
}
