<main id="main" tabindex="-1" class="d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="text-center w-100 max-w-1200 px-3 px-md-4">
        <div class="mb-4 mb-md-5">
            <i class="bi bi-briefcase-fill text-primary home-hero-icon" aria-hidden="true"></i>
            <h1 class="display-5 fw-bold text-dark mt-3">Welcome to RSP Portal</h1>
            <p class="lead text-muted">2026 Recruitment Selection Process. Digitized &amp; Optimized.</p>
            <h2 class="h4 mt-4 mt-md-5 fw-semibold">Please select your application type to begin</h2>
        </div>

        <div class="row justify-content-center g-4">
            <div class="col-md-5 col-sm-10">
                <button type="button" class="applicant-type-btn glass-card kiosk-btn p-4 p-md-5 bg-white shadow-lg text-center h-100 w-100" data-type="internal">
                    <i class="bi bi-building kiosk-icon" aria-hidden="true"></i>
                    <span class="d-block h2 fw-bold text-dark mb-3">Internal Applicant</span>
                    <span class="d-block text-muted fs-5 mb-0">For current employees applying for promotion, transfer, or reassignment.</span>
                </button>
            </div>

            <div class="col-md-5 col-sm-10">
                <button type="button" class="applicant-type-btn glass-card kiosk-btn p-4 p-md-5 bg-white shadow-lg text-center h-100 w-100" data-type="external">
                    <i class="bi bi-person-badge kiosk-icon" aria-hidden="true"></i>
                    <span class="d-block h2 fw-bold text-dark mb-3">External Applicant</span>
                    <span class="d-block text-muted fs-5 mb-0">For new applicants joining the organization from the outside.</span>
                </button>
            </div>
        </div>
    </div>
</main>

<!-- Position Selection Modal -->
<div class="modal fade" id="positionModal" tabindex="-1" aria-labelledby="positionModalLabel">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-fullscreen-md-down">
        <div class="modal-content overflow-hidden picker-modal">
            <div class="modal-header bg-primary text-white border-0">
                <h2 class="modal-title h5 fw-bold" id="positionModalLabel">Select Position Details</h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="picker">
                    <!-- Side Panel: Categories (stacks above the content on narrow screens) -->
                    <div class="picker-categories bg-light">
                        <div class="p-3 border-bottom bg-white">
                            <h3 class="mb-0 fw-bold text-secondary text-uppercase picker-categories-title" id="categoryListLabel">Position Categories</h3>
                        </div>
                        <div class="list-group list-group-flush" id="categoryList" role="group" aria-labelledby="categoryListLabel">
                            <!-- Populated via JS -->
                        </div>
                    </div>

                    <!-- Center Content -->
                    <div class="flex-grow-1 p-3 p-md-4 bg-white position-relative" id="centerContent" aria-live="polite">
                        <!-- Populated via JS -->
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="pickerData">{{{pickerJson}}}</script>
