<main id="main" tabindex="-1" class="d-flex align-items-center justify-content-center min-vh-100 px-3">
    <div class="glass-panel rounded-4 p-4 p-md-5 text-center max-w-600 w-100">
        <img src="/images/logos/DepEd%20Seal.png" alt="" width="72" height="72" class="mb-3">
        <p class="display-4 fw-bold text-primary mb-1">{{status}}</p>
        <h1 class="h3 fw-bold mb-3">{{heading}}</h1>
        <p class="text-muted mb-4">{{message}}</p>
        <a href="/" class="btn btn-primary px-4"><i class="bi bi-house-door me-2" aria-hidden="true"></i>Back to the portal home</a>
    </div>
</main>
