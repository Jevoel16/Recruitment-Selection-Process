<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if title}}{{title}} | {{/if}}RSP Portal</title>
    <meta name="description" content="{{#if description}}{{description}}{{else}}Apply online for DepEd Division of Iligan City positions through the 2026 Recruitment, Selection and Placement (RSP) Portal.{{/if}}">
    <link rel="icon" type="image/png" href="/images/logos/DepEd%20Seal.png">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Bootstrap CSS -->
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="/bootstrap-icons/bootstrap-icons.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/styles.css?v={{assetVersion}}">
    <!-- Bootstrap Bundle with Popper, then the page script (deferred so they run in order after parsing) -->
    <script src="/bootstrap/js/bootstrap.bundle.min.js" defer></script>
    {{#if script}}<script src="/js/{{script}}?v={{assetVersion}}" defer></script>{{/if}}
</head>
<body class="portal-body">
    <a class="visually-hidden-focusable skip-link" href="#main">Skip to main content</a>

    {{{body}}}
</body>
</html>
