DB_HOST=127.0.0.1
# Low-privilege user created by deploy/portal-db-user.sql (insert-only access to applicant tables)
DB_USER=rsp_portal
DB_PASSWORD=
DB_NAME=rsp_db
PORT=3001
# Loopback only: the public reaches the portal through the Cloudflare Tunnel, never directly
HOST=127.0.0.1
NODE_ENV=production
# cloudflared connects from loopback; trust its X-Forwarded-For so rate limiting is per applicant
TRUST_PROXY=loopback
